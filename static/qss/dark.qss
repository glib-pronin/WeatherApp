#sideBar {
    background-color: rgba(44, 44, 44, 153);
    /* background-color: rgba(255, 255, 255, 153); */
}

#themeSwitcher {
    background-color: #ffffff;
    border-radius: 12px;
    text-align: right;
    padding-right: 3px;
    border: none;
}

#selectedCity {
    background-color: rgba(44, 44, 44, 204);
    border-radius: 10px;
}

#text3 {
    color: rgba(255, 255, 255, 204);
}

#underline {
    border: 2px solid rgba(255, 255, 255, 80);
}