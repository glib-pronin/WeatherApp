#weatherWidget, #welcomeWidget, #sunnyWeather, #nightweather, #fewCloudyDayWeather,
#fewCloudyNightWeather, #cloudyWeather, #rainyWeather, #thunderstormWeather,
#snowyWeather{
    border-radius: 16px;
}

MainAppWindow[maximized="true"] #welcomeWidget, MainAppWindow[maximized="true"] #sunnyWeather, MainAppWindow[maximized="true"] #nightweather, MainAppWindow[maximized="true"] #fewCloudyDayWeather,
MainAppWindow[maximized="true"] #fewCloudyNightWeather, MainAppWindow[maximized="true"] #cloudyWeather, MainAppWindow[maximized="true"] #rainyWeather, MainAppWindow[maximized="true"] #thunderstormWeather,
MainAppWindow[maximized="true"] #snowyWeather{
    border-radius: 0px;
}

#sideBar {
    border-bottom-left-radius: 16px;
    border: none;
}

MainAppWindow[maximized="true"] #sideBar {
    border-radius: 0px;
}

MainAppWindow[maximized="true"] #topBar {
    border-radius: 0px;

}

#topBar {
    border-top-right-radius: 16px;
    border-top-left-radius: 16px;
}

#weatherWidget, #welcomeWidget {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #ff87cefa stop:1  #fd5);
}

#sunnyWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #87CEFA, stop:1 #FFDF56);
}

#nightweather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #191970, stop:1 #8A2BE2);
}

#fewCloudyDayWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #C0C0C0, stop:1 #FFD27F);
}

#fewCloudyNightWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #696969, stop:1 #9974BC);
}

#cloudyWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #A9A9A9, stop:1 #696969);
}

#rainyWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #808080, stop:1 #5DACE2);
}

#thunderstormWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #4A4A4A, stop:1 #5DACE2);
}

#snowyWeather {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #FFFFFF, stop:1 #B0C4DE);
}

QLabel, QPushButton {
    color: white;
    font-family: "Segoe UI";
    font-weight: 500;
}

#redBtn, #yellowBtn, #greenBtn {
    border-radius: 7px;
}

#redBtn {
    background-color: #FF5F57;
}
#redBtn::hover {
    background-color: #E04845;
}

#yellowBtn {
    background-color: #FEBC2E;
}

#yellowBtn::hover {
    background-color: #E0A700;
}

#greenBtn {
    background-color: #28C940;
}

#greenBtn::hover {
    background-color: #1DAF38;
}

#commandBtnClose, #commandBtnMaxBig, #commandBtnMaxSmall, #commandBtnMin {
    background-color: transparent;   
    border: none;
    font-size: 16px;
}

#commandBtnMaxBig {
    font-size: 26px;
}

#commandBtnClose {
    border-top-right-radius: 16px;
}

MainAppWindow[maximized="true"] #commandBtnClose {
    border-radius: 0px;
}

#welcomeWidget QLabel, #settingsModal QLabel, #settingsModal QRadioButton{
    color: white;
}

#settingsModal{
    background-color: rgba(54, 54, 54, 255);
    border-radius: 10px;
}  


#refreshBtn {
    border-radius: 6px;
    border: none;
    background-color: rgba(0, 0, 0, 51);
}

#refreshBtn:hover {
    background-color: rgba(0, 0, 0, 85);
}

#position, #weatherTempRange, #todayText, #forecastText, #titleText, #topPanelTitle, #sectionLabel, #selectedSectionLabel{
    font-size: 16px;
}

#settingsModal #sectionLabel {
    color: rgba(255, 255, 255, 51)
}

#settingsMainContent{
    border-left: 1px solid rgba(255, 255, 255, 51);
}

#selectedSectionLabel, #selectedIconListCard {
    background-color: rgba(0, 0, 0, 51);
    border-radius: 4px;
}

#city, #text1{
    font-size: 44px;
    font-weight: 700;
}

#tempValue {
    font-size: 74px;
    font-weight: 700;
}

#description, #dateText, #settingsTitle{
    font-size: 24px;
}

#tempRange{
    font-size: 24px;
    color: rgba(255, 255, 255, 150);
}

#scrollArea, #scrollContent, #cityFrame, #settingsScrollContent {
    background-color: transparent;
    border: none;
}

#text2 {
    font-size: 24px;
    font-weight: 700;
}

#text3 {
    font-size: 12px;
    font-weight: 600;
}

#searchInput {
    border: none;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    padding: 0;
    margin: 0;
    font-size: 16px;
    font-family: "Segoe UI";
    border: none;
}

#searchIcon {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

#cityAddFrame {
    font-size: 16px;
    font-family: "Segoe UI";
    border: none;
    border-radius: 5px;
}

#cityAddFrameText{
    font-size: 16px;
    padding-bottom: 1px;
}

#plusIcon{
    border: 1px solid #2C2C2C;;
    border-radius: 6px;
    font-size: 12px;
    padding-bottom: 2px;
}

#cityInfo {
    border-radius: 10px;
}

#settingsBlock {
    border-radius: 4px;
}

#searchingError{
    font-size: 16px;
    font-weight: bold;
}

#dialImg{
    border-radius: 84px;
}

#timeText {
    font-size: 28px;
}

#graphContainer {
    border-image: url("url_for_replacement1") 0 0 0 0 stretch stretch;
}

#yAxiousValue {
    font-size: 12px;
}

#chart {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 #87CEFA, stop:1 #FFDF56)
}

#settingsText, #settingsModal QRadioButton, #settingsSectionContentCaption, #cityLine, #messageLabel {
    font-size: 14px;
}

#settingsModal QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid white;
    background: transparent;
}

#settingsModal QRadioButton::indicator:checked {
background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                                fx:0.5, fy:0.5,
                                stop:0.6 white, stop:0.7 transparent);
}

#settingsModal QLineEdit{
    background-color: white;
    border-radius: 4px;
    padding-left: 10px;
    font-size: 12px;
}

#settingsModal QComboBox  {
    padding-left: 10px;
    background-color: white;
    border-radius: 4px;
    font-size: 12px;
}

#settingsModal QComboBox::drop-down {
    width: 16px;
    height: 16px;
    subcontrol-position: center right;
    border: none;
}

#settingsModal QComboBox::down-arrow {
    image: url("url_for_replacement2");
    width: 16px;
    height: 16px; 
    margin-right: 10px;
}

#settingsModal QScrollArea{
    background-color: rgba(0, 0, 0, 51);
    border-radius: 8px;
}

#activeSettingsButton {
    border-radius: 4px;
    background-color: black;
    color: white;
    font-size: 14px;
}

#disableSettingsButton {
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 51);
    color: rgba(255, 255, 255, 51);
    font-size: 14px;
}

#settingsSectionContentTitle {
    font-size: 18px;
}

#settingsIconLabel {
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 51);
}

QListView {
    font-size: 14px;
    padding: 5px;
}

QListView::item {
    padding: 5px;
}