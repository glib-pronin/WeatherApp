#sideBar {
    background-color: rgba(255, 255, 255, 153);
}

#themeSwitcher {
    background-color:  #2C2C2C;
    border-radius: 12px;
    text-align: left;
    padding-left: 3px;
    border: none;
}

QLabel {
    color: #2C2C2C
}

#selectedCity{
    background-color: rgba(255, 255, 255, 204);
    border-radius: 10px;
}

#text3 {
    color: rgba(44, 44, 44, 204);
}

#underline {
    border: 2px solid rgba(44, 44, 44, 80);
}

#searchInput {
    background-color: rgba(255, 255, 255, 51);
    color: #2C2C2C;
}

#searchIcon {
    background-color: rgba(255, 255, 255, 51);
}

#cityAddFrame{
    background-color: rgba(255, 255, 255, 51);
}

#cityAddFrame::hover{
    background-color: rgba(255, 255, 255, 102);
}